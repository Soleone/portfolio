{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs"],
  "jsPlugins": ["@shadcn/lint"],
  "ignorePatterns": ["public/**", "next-env.d.ts"],
  "settings": {
    "shadcn": {
      "ui": "@/components/ui",
      "note": "Follow the design tokens and component variants defined in app/globals.css, components/theme and components/ui."
    }
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@base-ui/react", "@base-ui/react/*"],
            "message": "Use a local high-level component from @/components/ui instead of importing Base UI primitives directly."
          }
        ]
      }
    ],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "error"
  },
  "overrides": [
    {
      "files": ["components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/no-unknown-classes": "off",
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "components/portfolio/coins.tsx",
        "components/portfolio/project-card.tsx",
        "components/portfolio/skill-graph-scene.tsx",
        "components/soleone/**"
      ],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    }
  ]
}
